        "fontFamily": "Gothic A1, sans-serif",
        "fontWeight": 300,
        "textDecoration": "none"
      },
      "value": "We issue this certificate without any obligation or liability on the part of Pinnacle Tech Enterprises.",
      "autoScale": false
    },
    {
